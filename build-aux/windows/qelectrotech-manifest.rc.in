// Embeds qelectrotech.exe.manifest as the program's manifest
// (resource id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, type 24 = RT_MANIFEST).
1 24 "@QET_MANIFEST_FILE@"
// The program icon (Explorer, desktop shortcuts, taskbar), as in the official builds
IDI_ICON1 ICON "@QET_ICON_FILE@"

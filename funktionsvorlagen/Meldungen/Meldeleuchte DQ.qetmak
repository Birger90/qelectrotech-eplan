<qet_macro>
    <function_template category="Meldungen" name="Meldeleuchte DQ" version="1">
        <description>Leuchtmelder am SPS-Ausgang. Die Farbe wählt Frontelement und LED-Element.</description>
        <parameter default="PF1" kind="label" label="Kennzeichen" name="BMK"/>
        <parameter default="Betrieb" label="Funktion" name="TEXT"/>
        <parameter default="grün" label="Farbe" name="FARBE"/>
        <parameter default="%Q0.2" io="DQ" kind="address" label="SPS-Ausgang" name="ADR"/>
        <table key="FARBE">
            <row FARBE="grün" P_ART="M22-L-G + M22-A + M22-LED-G"/>
            <row FARBE="gelb" P_ART="M22-L-Y + M22-A + M22-LED-Y"/>
            <row FARBE="rot" P_ART="M22-L-R + M22-A + M22-LED-R"/>
            <row FARBE="weiß" P_ART="M22-L-W + M22-A + M22-LED-W"/>
            <row FARBE="blau" P_ART="M22-L-B + M22-A + M22-LED-B"/>
        </table>
    </function_template>

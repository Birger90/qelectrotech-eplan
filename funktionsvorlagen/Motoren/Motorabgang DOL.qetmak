<qet_macro>
    <function_template category="Motoren" name="Motorabgang DOL" version="1">
        <description>Direktanlauf: Motorschutzschalter, Schütz am SPS-Ausgang, Klemmen, Motorleitung und Drehstrommotor. Die Leistung wählt Schutzschalter, Schütz und Leitung (Richtwerte 400 V).</description>
        <parameter default="MA1" kind="label" label="Kennzeichen Motor" name="BMK"/>
        <parameter default="4" label="Leistung" name="P_kW" unit="kW"/>
        <parameter default="Antrieb" label="Funktion" name="TEXT"/>
        <parameter default="%Q0.0" io="DQ" kind="address" label="SPS-Ausgang" name="ADR"/>
        <parameter default="X1" label="Klemmleiste" name="X"/>
        <parameter default="" kind="terminal" label="erste Klemme" name="XN" of="X"/>
        <parameter default="W1" kind="cable" label="Kabel" name="W"/>
        <table key="P_kW">
            <row I_N="1.1 A" KM_ART="3RT2015-1BB41" P_kW="0.37" QA_ART="3RV2011-1AA10" QA_I="1,1...1,6 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="1.5 A" KM_ART="3RT2015-1BB41" P_kW="0.55" QA_ART="3RV2011-1AA10" QA_I="1,1...1,6 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="1.9 A" KM_ART="3RT2015-1BB41" P_kW="0.75" QA_ART="3RV2011-1BA10" QA_I="1,4...2 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="2.6 A" KM_ART="3RT2015-1BB41" P_kW="1.1" QA_ART="3RV2011-1DA10" QA_I="2,2...3,2 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="3.5 A" KM_ART="3RT2015-1BB41" P_kW="1.5" QA_ART="3RV2011-1EA10" QA_I="2,8...4 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="4.9 A" KM_ART="3RT2015-1BB41" P_kW="2.2" QA_ART="3RV2011-1FA10" QA_I="3,5...5 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="6.5 A" KM_ART="3RT2015-1BB41" P_kW="3" QA_ART="3RV2011-1HA10" QA_I="5,5...8 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="8.5 A" KM_ART="3RT2016-1BB41" P_kW="4" QA_ART="3RV2011-1JA10" QA_I="7...10 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="11.5 A" KM_ART="3RT2017-1BB41" P_kW="5.5" QA_ART="3RV2011-1KA10" QA_I="9...12,5 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="15.5 A" KM_ART="3RT2018-1BB41" P_kW="7.5" QA_ART="3RV2011-4AA10" QA_I="11...16 A" W_TYP="Motorleitung 4G2,5"/>
            <row I_N="22 A" KM_ART="3RT2026-1BB40" P_kW="11" QA_ART="3RV2021-4DA10" QA_I="18...25 A" W_TYP="Motorleitung 4G4"/>
            <row I_N="29 A" KM_ART="3RT2027-1BB40" P_kW="15" QA_ART="3RV2021-4EA10" QA_I="27...32 A" W_TYP="Motorleitung 4G6"/>
        </table>
    </function_template>

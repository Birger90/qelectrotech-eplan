<qet_macro>
    <function_template category="Motoren" name="Motorabgang Stern-Dreieck" version="1">
        <description>Stern-Dreieck-Anlauf: Motorschutzschalter, Netz- und Dreieckschütz dahinter, Sternschütz mit Sternbrücke, jedes Schütz am SPS-Ausgang (ADR, ADR+1, ADR+2), zwei Motorleitungen, Motor mit sechs Anschlüssen. Die Leistung wählt Schutzschalter, Schütze und Leitung (Richtwerte 400 V). Stern und Dreieck gegeneinander verriegeln.</description>
        <parameter default="MA1" kind="label" label="Kennzeichen Motor" name="BMK"/>
        <parameter default="7.5" label="Leistung" name="P_kW" unit="kW"/>
        <parameter default="Antrieb" label="Funktion" name="TEXT"/>
        <parameter default="%Q0.0" label="SPS-Ausgang Netz" name="ADR"/>
        <parameter default="X1" label="Klemmleiste" name="X"/>
        <parameter default="" kind="terminal" label="erste Klemme" name="XN" of="X"/>
        <parameter default="W1" kind="cable" label="Kabel" name="W"/>
        <table key="P_kW">
            <row I_N="11.5 A" KM_ART="3RT2015-1BB41" KS_ART="3RT2015-1BB41" P_kW="5.5" QA_ART="3RV2011-1KA10" QA_I="9...12,5 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="15.5 A" KM_ART="3RT2016-1BB41" KS_ART="3RT2015-1BB41" P_kW="7.5" QA_ART="3RV2011-4AA10" QA_I="10...16 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="22 A" KM_ART="3RT2018-1BB41" KS_ART="3RT2016-1BB41" P_kW="11" QA_ART="3RV2021-4CA10" QA_I="18...25 A" W_TYP="Motorleitung 4G1,5"/>
            <row I_N="29 A" KM_ART="3RT2025-1BB40" KS_ART="3RT2017-1BB41" P_kW="15" QA_ART="3RV2021-4EA10" QA_I="27...32 A" W_TYP="Motorleitung 4G2,5"/>
        </table>
    </function_template>

        <parameter default="Endlage" label="Funktion" name="TEXT"/>
        <parameter default="%I0.0" label="SPS-Eingang" name="ADR"/>
        <parameter default="X2" label="Klemmleiste" name="X"/>
        <parameter default="" kind="terminal" label="erste Klemme" name="XN" of="X"/>
        <parameter default="W1" kind="cable" label="Kabel" name="W"/>
        <parameter default="PUR 3x0,34" label="Kabeltyp" name="W_TYP"/>
        <parameter default="" label="Sensor-Artikel" name="B_ART"/>
    </function_template>

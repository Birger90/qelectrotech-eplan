        <parameter default="Zylinder ausfahren" label="Funktion" name="TEXT"/>
        <parameter default="%Q0.1" io="DQ" kind="address" label="SPS-Ausgang" name="ADR"/>
        <parameter default="X3" label="Klemmleiste" name="X"/>
        <parameter default="" kind="terminal" label="erste Klemme" name="XN" of="X"/>
        <parameter default="W1" kind="cable" label="Kabel" name="W"/>
        <parameter default="PUR 3x0,75" label="Kabeltyp" name="W_TYP"/>
        <parameter default="" label="Ventil-Artikel" name="V_ART"/>

<qet_macro>
    <function_template category="Ventile" name="Ventil mit DQ-Kanal" version="1">
        <description>Magnetventil mit Gerätestecker am SPS-Ausgang: Klemmen, Kabel, Schutzleiter. Der Kanal wird mit dem SPS-Modul verknüpft, das die Adresse hat.</description>
